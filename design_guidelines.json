  },
  "dos_and_donts": {
    "do": [
      "Use gradient text sparingly for key emphasis (e.g., specific words in H1)",
      "Maintain high contrast for all text (APCA standards)",
      "Include data-testid on all interactive elements (e.g., data-testid='tool-card-copy-btn')",
      "Use generous padding within cards to let content breathe",
      "Ensure tool inputs/outputs use mono font for data/code"
    ],
    "dont": [
      "Do NOT use the word 'AI' anywhere in public-facing UI",
      "Do not center-align long paragraphs or dense tool settings",
      "Do not use full-screen flat color backgrounds without texture/gradients",
      "Do not use Inter or Space Grotesk fonts",
      "Do not hide main nav links behind hamburger on desktop"
    ]
  },
  "instructions_to_main_agent": [
    "Install fonts: npm install @fontsource/plus-jakarta-sans @fontsource/dm-sans @fontsource/jetbrains-mono",
    "Configure tailwind.config.js with the provided color tokens and fonts",
    "Implement light/dark mode toggle (next-themes or standard tailwind dark mode)",
    "Build the Command Palette (Cmd+K) using Shadcn Dialog/Command components, ensuring glassmorphism style",
    "For the hero parallax, use framer-motion useScroll to move background floating elements slightly as the user scrolls",
    "All navigation/footer links must be functional or explicitly marked as under construction. Tool cards must link to dynamic /tool/:id pages.",
    "Do NOT use placeholder text for logos; always render the provided logo URL.",
    "Make sure the admin dashboard sidebar is collapsible on mobile.",
    "Add 'data-testid' to ALL interactive elements (buttons, links, inputs, dialogs)!"
  ]
}